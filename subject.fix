# Prepare maps

do once("maps")
  put_filemap("$[LOOKUP_FILE]", "$[CATALOGUE]Id2AlmaMmsId", sep_char:"\t", key_column:"1", value_column:"0", expected_columns:"-1")
end

# Skip records without 689

unless exists("689??")
    reject()
end

# Move system id 001 to 035 and append system isil

copy_field("001","@$[CATALOGUE]Id")
prepend("@$[CATALOGUE]Id","($[SYSTEM_ISIL])")
if is_array("035  ")
    copy_field("@$[CATALOGUE]Id","035  .$append.a")
else
    move_field("035  ","@035  ")
    copy_field("@035  ","035  .$append")
    copy_field("@$[CATALOGUE]Id","035  .$append.a")
end

# Assigne hbz almaMmsId with lookup map

lookup("001","$[CATALOGUE]Id2AlmaMmsId")

# Delete all non GND Ids in $$0 which do not have Prefix (DE-588) and make the linkage uniq.

do list(path:"689??","var":"$i")
    if is_array("$i.0")
        replace_all("$i.0.*","^(?!\\(DE-588\\)).*$","")
    else
        replace_all("$i.0","^(?!\\(DE-588\\)).*$","")
    end
    uniq("$i.5")
    remove_field("$i.2")
end

# Only keep 001, 035 and 689
retain("001","689??","035??")
vacuum()