# Prepare maps

do once("maps")
  put_filemap("$[lookupFile]", "$[catalogue]Id2AlmaMmsId", sep_char:"\t", key_column:"1", value_column:"0", expected_columns:"-1")
end

# Skip records without 689

unless exists("689??")
    reject()
end



copy_field("001","@$[catalogue]Id")
prepend("@$[catalogue]Id","($[systemIsil])")
if is_array("035  ")
    copy_field("@$[catalogue]Id","035  .$append.a")
else
    move_field("035  ","@035  ")
    copy_field("@035  ","035  .$append")
    copy_field("@$[catalogue]Id","035  .$append.a")
end

lookup("001","$[catalogue]Id2AlmaMmsId")

do list(path:"689??","var":"$i")
    replace_all("$i.0.*","^(?!\\(DE-588\\)).*$","")
    uniq("$i.5")
end

# Only keep 001 and 689
retain("001","689??","035??")
vacuum()