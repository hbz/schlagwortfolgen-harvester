# Prepare maps

do once("maps")
  put_filemap("$[lookupFile]", "$[catalogue]Id2AlmaMmsId", sep_char:"\t", key_column:"1", value_column:"0", expected_columns:"-1")
end

# Copy id and lookup matching almaMmsId

copy_field("0","almaMmsId")
move_field("0","$[catalogue]Id")
lookup("almaMmsId","$[catalogue]Id2AlmaMmsId")