  <datafield tag="245" ind1=" " ind2=" ">
    <subfield code="a">Sch&#xF6;n wild!</subfield>
    <subfield code="b">attraktive Beete mit heimischen Wildstauden im Garten : 22 Gestaltungsideen f&#xFC;r jeden Standort</subfield>
    <subfield code="c">Brigitte Kleinod und Friedhelm Strickler ; illustriert von Heidi Janicek</subfield>
  </datafield>
  <datafield tag="250" ind1=" " ind2=" ">
    <subfield code="a">3. Auflage</subfield>
  </datafield>
  <datafield tag="260" ind1=" " ind2=" ">
